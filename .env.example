# Copy to .env. Generate secrets with: openssl rand -hex 32

# Public address of the app. No trailing slash.
BASE_URL=http://localhost:8000
# Caddy serves HTTPS for this name. Use your real domain on the server.
LITELINK_DOMAIN=localhost

POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me

# Google Cloud console > OAuth client. Authorized redirect URI: <BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. Nobody else can sign in while the scanner is still a stub.
ALLOWED_EMAILS=you@example.com

# Optional, for evals/collect.py. Without it, Safe Browsing status is saved as unknown.
SAFE_BROWSING_API_KEY=
